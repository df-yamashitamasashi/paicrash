# ============================================================
# paicrashg 環境変数設定例
# このファイルをコピーして .env.local を作成してください
# .env.local は .gitignore に含まれており、リポジトリにコミットされません
# ============================================================

# ----------------------------------------------------------------
# クライアント設定（Next.js）
# ----------------------------------------------------------------

# Socket.IO サーバーの接続先 URL
# ローカル開発: http://localhost:3001
# ローカル LAN: http://192.168.x.x:3001  （同一ネットワーク内の IP アドレスを指定）
# AWS 本番:     wss://api.your-domain.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# 招待コード（UUID形式など）
# このコードを知っているユーザーのみがサイトにアクセスできます。
INVITE_CODE=123e4567-e89b-12d3-a456-426614174000

# ----------------------------------------------------------------
# サーバー設定（server/index.ts）
# ----------------------------------------------------------------

# Socket.IO サーバーのリッスンポート
PORT=3001

# CORS 許可オリジン（カンマ区切りで複数指定可能）
# ローカル開発: http://localhost:3000
# ローカル LAN: http://192.168.x.x:3000,http://192.168.x.y:3000
# AWS 本番:     https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------
# AWS CDK デプロイ設定
# ----------------------------------------------------------------

# AWS WAF の有効化 (true/false)
# コストを抑えたい場合は false に設定してください。
ENABLE_WAF=false

# ECS Fargate Spot の有効化 (true/false)
# true にするとコンピュート料金を大幅に削減できます。
USE_FARGATE_SPOT=true
